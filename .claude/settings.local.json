{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(sleep *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(vercel *)",
      "Bash(jq *)",
      "Bash(tsc *)",
      "Bash(prettier *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(date *)",
      "Bash(touch *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*TRUNCATE*)",
      "Bash(*--no-verify*)"
    ]
  },
  "hooks": {
    "PostToolUse": [],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"== Post-Compaction Context ==\" && echo \"Branch: $(git branch --show-current 2>/dev/null)\" && echo \"Recent commits:\" && git log --oneline -5 2>/dev/null && echo \"Modified files:\" && git diff --name-only HEAD~3 2>/dev/null | head -20 && echo \"== End Context ==\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start-resume-nudge.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-handoff-nudge.sh"
          }
        ]
      }
    ]
  }
}
