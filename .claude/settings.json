{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-verifier.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-destructive.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-sensitive.sh"
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "mcp__github__pull_request_read",
      "mcp__Linear__list_issues",
      "mcp__Linear__list_teams",
      "mcp__Linear__list_issue_labels",
      "mcp__Linear__list_issue_statuses",
      "mcp__Linear__search_documentation"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
